{
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 150,
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"quoteProps": "as-needed",
	"singleAttributePerLine": false,
	"overrides": [
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		}
	]
}
