---
// Closing banner — the last thing a skimmer sees before bouncing.
// One command, one button, done.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="lx-cta">
  <div class="lx-cta__inner">
    <div class="lx-cta__left">
      <h2>Ship the first process in under two minutes.</h2>
      <p>One <code>.deb</code>, one systemd unit, one CLI. Your services keep running when you log out — that's the whole pitch.</p>
    </div>
    <div class="lx-cta__right">
      <div class="lx-cta__code">
        <span class="lx-cta__prompt">$</span>
        <code>sudo apt install ./unitpm_*_amd64.deb</code>
        <button type="button" class="lx-copy lx-cta__copy" aria-label="Copy install command" data-copy="sudo apt install ./unitpm_*_amd64.deb">
          <svg class="lx-copy__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15 V5 A2 2 0 0 1 7 3 H15"/></svg>
          <svg class="lx-copy__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12 L10 17 L19 7"/></svg>
        </button>
      </div>
      <a class="lx-cta__button" href={`${base}/start/quickstart/`}>Read the quickstart →</a>
    </div>
  </div>
</section>
