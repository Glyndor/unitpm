---
// Landing hero with a gradient headline on the left and a live-looking
// terminal preview on the right. No JavaScript — everything is static
// markup so SEO crawlers see it and first-paint is immediate.
---
<section class="lx-hero">
  <div class="lx-hero__inner">
    <div class="lx-hero__copy">
      <div class="lx-hero__pill">
        <span class="lx-hero__dot"></span>
        <span>v0.9.8 · systemd-native · Linux</span>
      </div>
      <h1 class="lx-hero__title">
        Run your apps like
        <span class="lx-hero__title-accent">production infrastructure</span>
        should.
      </h1>
      <p class="lx-hero__tagline">
        Lynx is the secure, <strong>systemd-native</strong> process manager
        for Linux. A lean, hardened alternative to PM2 and Supervisor —
        ~10 MB of compiled Go, zero-privilege deploy out of the box.
      </p>
      <div class="lx-hero__cta">
        <a class="lx-hero__cta-primary" href="/Lynx/start/install/">
          Install in 30 seconds
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a class="lx-hero__cta-secondary" href="https://github.com/Jaro-c/Lynx">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.61 8.21 11.16.6.11.82-.26.82-.57 0-.28-.01-1.03-.02-2.02-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.73-1.34-1.73-1.09-.73.08-.72.08-.72 1.21.08 1.85 1.22 1.85 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.66-.3-5.46-1.31-5.46-5.83 0-1.29.47-2.34 1.23-3.17-.12-.3-.54-1.5.12-3.12 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 016 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.62.25 2.82.12 3.12.77.83 1.23 1.88 1.23 3.17 0 4.53-2.81 5.53-5.48 5.82.43.37.82 1.1.82 2.21 0 1.6-.02 2.89-.02 3.28 0 .31.22.69.83.57A12.02 12.02 0 0024 12.29C24 5.78 18.63.5 12 .5z"/>
          </svg>
          View on GitHub
        </a>
      </div>
      <dl class="lx-hero__stats">
        <div>
          <dt>Base RAM</dt>
          <dd>~10 <span>MB</span></dd>
        </div>
        <div>
          <dt>Startup</dt>
          <dd>&lt;50 <span>ms</span></dd>
        </div>
        <div>
          <dt>Overhead</dt>
          <dd>1 <span>binary</span></dd>
        </div>
      </dl>
    </div>
    <div class="lx-hero__terminal" aria-hidden="true">
      <div class="lx-term">
        <div class="lx-term__bar">
          <span class="lx-term__dot lx-term__dot--red"></span>
          <span class="lx-term__dot lx-term__dot--amber"></span>
          <span class="lx-term__dot lx-term__dot--green"></span>
          <span class="lx-term__path">~ </span>
        </div>
        <pre class="lx-term__body"><code><span class="lx-term__prompt">$</span> <span class="lx-term__cmd">lynxpm start "node server.js" --name api --restart always</span>
<span class="lx-term__ok">✓</span> Started api
  ID:     019dbd20-08dd-…
  PID:    2336612
  Status: <span class="lx-term__ok">running</span>

┌──────────┬────────┬──────────┬─────────┬────────┐
│ id       │ name   │ namespace│ status  │ pid    │
├──────────┼────────┼──────────┼─────────┼────────┤
│ <span class="lx-term__hl">▸</span> 019dbd │ api    │ default  │ <span class="lx-term__ok">running</span> │ 2336612│
└──────────┴────────┴──────────┴─────────┴────────┘
<span class="lx-term__prompt">$</span> <span class="lx-term__cursor"> </span></code></pre>
      </div>
    </div>
  </div>
</section>
