// Polkit rules for the lynx system-mode daemon.
//
// The `lynx` user needs to call systemd-run with DynamicUser=yes to implement
// `--isolation dynamic`. Without this rule systemd would require interactive
// admin authentication, and the daemon (non-interactive) would fail silently.
//
// Security boundary: these rules trust the `lynx` system user. The daemon
// binary is the only code expected to run under that uid. Compromise of
// lynxd would grant the attacker these same systemd powers.
polkit.addRule(function(action, subject) {
    if (subject.user != "lynx") {
        return undefined;
    }

    // Allow transient-unit creation (systemd-run) and managing existing
    // units. For StartTransientUnit, the "unit" detail is not always
    // populated at check time across systemd versions, so we can't reliably
    // restrict by unit-name prefix here.
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        // When a unit name is supplied (start/stop/restart on an existing
        // unit) keep the prefix restriction so lynxd cannot touch sshd etc.
        if (unit) {
            if (unit.indexOf("lynx-") == 0) {
                return polkit.Result.YES;
            }
            return polkit.Result.NO;
        }
        // No unit detail (typical for StartTransientUnit) — allow, since
        // lynxd only ever calls systemd-run with --unit=lynx-app-*.
        return polkit.Result.YES;
    }

    // Unit-file management (enable/disable) is not used by lynxd today,
    // but keep scoped to lynx-* if ever called.
    if (action.id == "org.freedesktop.systemd1.manage-unit-files") {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("lynx-") == 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});
