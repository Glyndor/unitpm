polkit.addRule(function(action, subject) {
    if (subject.user == "lynx") {
        // Allow managing systemd units ONLY if they start with "lynx-"
        // This prevents the lynx user from stopping critical system services (like sshd).
        if (action.id == "org.freedesktop.systemd1.manage-units") {
            var unit = action.lookup("unit");
            if (unit && unit.indexOf("lynx-") == 0) {
                return polkit.Result.YES;
            }
        }
        
        // Allow systemd-run to start transient units
        // Systemd-run checks manage-units permission.
        // The above check restricts modifications to existing units,
        // but for creating NEW transient units via systemd-run, specific checks apply.
        // We trust systemd to enforce User= restrictions for transient units 
        // unless explicit privileges are granted.
    }
});
