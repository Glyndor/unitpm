#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Create unitpm group if it doesn't exist
    if ! getent group unitpm >/dev/null; then
        addgroup --system unitpm
    fi

    # Create glyndor-unitpm user if it doesn't exist
    if ! getent passwd glyndor-unitpm >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/glyndor/unitpm glyndor-unitpm
    fi

    # Ensure glyndor-unitpm user is a member of unitpm
    adduser glyndor-unitpm unitpm || true

    # Ensure state and log directories exist with restrictive ownership
    mkdir -p /var/lib/glyndor/unitpm /var/log/glyndor/unitpm
    chown glyndor-unitpm:glyndor-unitpm /var/lib/glyndor/unitpm /var/log/glyndor/unitpm
    chmod 0700 /var/lib/glyndor/unitpm /var/log/glyndor/unitpm
fi

# Signal running user-mode daemons so they re-exec with the new binary.
# Managed processes experience ~1s downtime while the daemon restarts and
# restores them from specs on disk. The system daemon is handled by
# systemd's dh-generated restart hook.
for pid in $(pgrep -x unitpmd 2>/dev/null); do
    pid_user=$(ps -o user= -p "$pid" 2>/dev/null)
    if [ -n "$pid_user" ] && [ "$pid_user" != "glyndor-unitpm" ]; then
        kill -HUP "$pid" 2>/dev/null || true
    fi
done

#DEBHELPER#
