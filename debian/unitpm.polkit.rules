// Polkit rules for the unitpm system-mode daemon (unitpmd).
//
// The `glyndor-unitpm` user needs to call systemd-run with DynamicUser=yes to implement
// `--isolation dynamic`. Without this rule systemd would require interactive
// admin authentication, and the daemon (non-interactive) would fail silently.
//
// Security boundary: these rules trust the `glyndor-unitpm` system user. The daemon
// binary is the only code expected to run under that uid. Compromise of
// unitpmd would grant the attacker these same systemd powers.
polkit.addRule(function(action, subject) {
    if (subject.user != "glyndor-unitpm") {
        return undefined;
    }

    // Allow transient-unit creation (systemd-run) and managing existing
    // units, but always require a unit name with the `glyndor-unitpm-` prefix.
    // Modern systemd (>= 235, all currently supported Debian/Ubuntu
    // releases) populates the "unit" detail for StartTransientUnit, so
    // an empty value is treated as a deny rather than a permissive
    // fallback — preventing a compromised unitpmd from touching unrelated
    // units (sshd, networkd, etc.).
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("unitpm-app-") == 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }

    // Unit-file management (enable/disable) is not used by unitpmd today,
    // but keep scoped to glyndor-unitpm-* if ever called.
    if (action.id == "org.freedesktop.systemd1.manage-unit-files") {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("unitpm-app-") == 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});
