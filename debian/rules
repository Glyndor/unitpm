#!/usr/bin/make -f

export LC_ALL := C
export UNITPM_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
export UNITPM_BUILD_DATE := $(shell date -u +'%Y-%m-%dT%H:%M:%SZ')

# Build against musl and link statically, so the package declares no libc
# floor and installs on every supported release. Glyndor/podup#1512 is why:
# every dynamically-linked .deb there carried `libc6 (>= 2.39)`, which
# excluded Debian 12 (2.36) and Ubuntu 22.04 (2.35), and apt simply refused.
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
RUST_TARGET_amd64 = x86_64-unknown-linux-musl
RUST_TARGET_arm64 = aarch64-unknown-linux-musl
RUST_TARGET = $(RUST_TARGET_$(DEB_HOST_ARCH))
ifeq ($(RUST_TARGET),)
$(error no musl Rust target is mapped for DEB_HOST_ARCH=$(DEB_HOST_ARCH); add one above)
endif

BUILT = target/$(RUST_TARGET)/release

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --target $(RUST_TARGET)

override_dh_auto_test:
	cargo test --release --locked --target $(RUST_TARGET)

override_dh_auto_install:
	install -D -m 0755 $(BUILT)/unitpm debian/unitpm/usr/bin/unitpm
	install -D -m 0755 $(BUILT)/unitpmd debian/unitpm/usr/sbin/unitpmd

# Install debian/unitpm.unitpmd.service as /lib/systemd/system/unitpmd.service.
# Without --name=unitpmd, dh_installsystemd looks for debian/unitpm.service
# (package-named) and skips the unit file entirely.
override_dh_installsystemd:
	dh_installsystemd --name=unitpmd

override_dh_dwz:
	# Skip dwz compression: a statically-linked binary has nothing to dedupe.
